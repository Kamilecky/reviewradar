# Copy this file to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_SETTINGS_MODULE=reviewradar.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (used only by reviewradar.settings.prod; dev uses local SQLite)
DATABASE_URL=postgres://reviewradar:reviewradar@localhost:5432/reviewradar

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Django's cache (products/rate_limit.py's counters, DRF throttling) --
# separate DB index from the Celery broker above so cache keys and queue
# data don't mix.
DJANGO_CACHE_URL=redis://localhost:6379/1

# Email (password reset, future price-drop notifications). Leave EMAIL_BACKEND
# at the console default for local dev -- emails print to stdout, no SMTP
# account needed. For production, set EMAIL_BACKEND to
# django.core.mail.backends.smtp.EmailBackend and fill in the rest.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ReviewRadar <noreply@reviewradar.local>

# Registration throttling (accounts/views.py::register) -- per-IP, per hour.
REGISTER_IP_RATE_PER_HOUR=5

# How many days back a product still counts as "recently added" for the
# periodic review-refresh task.
REVIEW_REFRESH_WINDOW_DAYS=30

# Minimum time between classify_sentiment retry attempts for the same Review
# after a failed attempt -- avoids hammering the Anthropic API for a review
# that just failed, every single analyze_product_reviews run.
SENTIMENT_RETRY_COOLDOWN_MINUTES=15

# Search cost-path limits (products/web_views.py::product_search) -- gate
# auto-creating a new Product from an unmatched search + the live
# YouTube/Google Places fetch that comes with it. Plain search over the
# existing catalog is never limited by these.
SEARCH_COST_PATH_IP_RATE_PER_HOUR=5
DAILY_NEW_PRODUCT_LIMIT=200

# Daily API usage alert thresholds (analysis/usage.py) -- logged as
# CRITICAL when exceeded (see the TODO there for Slack/Sentry). Leave at 0
# (or unset) to disable alerting for that provider. Units: tokens for
# Anthropic, request count for everything else.
DAILY_ANTHROPIC_TOKEN_BUDGET=0
DAILY_YOUTUBE_REQUEST_BUDGET=0
DAILY_GOOGLE_PLACES_REQUEST_BUDGET=0
DAILY_CRAWLBASE_REQUEST_BUDGET=0
DAILY_REDDIT_REQUEST_BUDGET=0

# Reddit API (create an app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=reviewradar/0.1 by u/your-reddit-username
REDDIT_SUBREDDITS=headphones,laptops,tablets,smartphones,buildapc
REDDIT_SEARCH_LIMIT=25

# Forum scraping
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; ReviewRadarBot/0.1; +https://example.com/bot)
SCRAPER_MIN_DELAY_SECONDS=2.0
SCRAPER_MAX_DELAY_SECONDS=5.0

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Only needed if ANTHROPIC_API_KEY is an identity-linked (SSO/workspace)
# key -- find it in the Anthropic Console under the workspace's settings.
# Leave blank for a regular API key (most keys don't need this).
ANTHROPIC_WORKSPACE_ID=

# Google Places API - official REST API, no scraping/ToS check needed, but
# has request quotas and billing. Create a project + enable "Places API" at
# https://console.cloud.google.com/, then generate an API key.
GOOGLE_PLACES_API_KEY=

# YouTube Data API v3 - official REST API, no scraping/ToS check needed, but
# has a daily quota. Create a project + enable "YouTube Data API v3" at
# https://console.cloud.google.com/, then generate an API key.
YOUTUBE_API_KEY=

# Crawlbase - fetches one specific, already-known Reddit post URL at a time
# (scraper=reddit-post), rather than searching by product name. Get a token
# from your Crawlbase dashboard: https://crawlbase.com/dashboard
CRAWLBASE_TOKEN=
